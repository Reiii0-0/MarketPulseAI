    },
    "flat_price_tie_policy": {
      "anchor_bar_end": "2025-01-15T15:01:00Z",
      "present_bars": {
        "2025-01-15T15:01:00Z": 150.0,
        "2025-01-15T15:06:00Z": 150.0
      },
      "expected_status": "realized",
      "expected_direction": "NOT_UP",
      "expected_return_5m": 0.0
