    "session_close_boundary": {
      "anchor_bar_end": "2025-01-15T20:58:00Z",
      "note": "Jan 15 is EST (UTC-5): US close 16:00 EST = 21:00 UTC. Target 21:03 UTC is after close.",
      "present_bars": {
        "2025-01-15T20:58:00Z": 200.0,
        "2025-01-15T21:03:00Z": 201.0
