# =============================================================================
# MarketPulseAI — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in all REQUIRED values.
# DO NOT commit the .env file to version control.
# All variables are consumed via pydantic-settings in each service.
# =============================================================================


# -----------------------------------------------------------------------------
# POSTGRESQL — Shared database credentials
# -----------------------------------------------------------------------------

# PostgreSQL host (use service name within Docker Compose network)
POSTGRES_HOST=postgres

# PostgreSQL port (default: 5432)
POSTGRES_PORT=5432

# PostgreSQL database name  ← REQUIRED
POSTGRES_DB=marketpulse

# PostgreSQL application user  ← REQUIRED
POSTGRES_USER=marketpulse_user

# PostgreSQL password for the application user  ← REQUIRED
# Minimum 16 characters. Use a password manager to generate.
POSTGRES_PASSWORD=changeme_use_a_strong_password_here

# PostgreSQL connection pool settings (for consumer and API services)
# Minimum connections kept alive in the pool
POSTGRES_POOL_MIN_CONN=2
# Maximum connections allowed in the pool
POSTGRES_POOL_MAX_CONN=10

# Connection timeout in seconds
POSTGRES_CONNECT_TIMEOUT=5


# -----------------------------------------------------------------------------
# KAFKA — Broker and topic configuration
# -----------------------------------------------------------------------------

# Kafka bootstrap server (use service name within Docker Compose network)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Kafka topic for raw market tick events
KAFKA_TOPIC_MARKET_TICKS=raw.market.ticks

# Kafka topic for raw sentiment events
KAFKA_TOPIC_SENTIMENT_EVENTS=raw.sentiment.events

# Number of partitions for each topic (must match broker topic config)
KAFKA_TOPIC_PARTITIONS=3

# Kafka consumer group ID for the tick consumer service
KAFKA_CONSUMER_GROUP_TICKS=tick-consumer-group-v1

# Kafka consumer group ID for the sentiment consumer service
KAFKA_CONSUMER_GROUP_SENTIMENT=sentiment-consumer-group-v1

# Kafka producer acks setting: 'all' = highest durability
KAFKA_PRODUCER_ACKS=all

# Number of times the producer retries on transient failures
KAFKA_PRODUCER_RETRIES=3

# Maximum time (ms) a produce request can be blocked
KAFKA_PRODUCER_MAX_BLOCK_MS=60000

# Kafka message size limit in bytes (default: 1MB)
KAFKA_MAX_MESSAGE_BYTES=1048576

# Kafka consumer poll timeout in seconds
KAFKA_CONSUMER_POLL_TIMEOUT_SECONDS=1.0

# Kafka consumer auto offset reset: 'earliest' | 'latest'
# Set to 'earliest' for replay scenarios so no messages are missed on restart
KAFKA_AUTO_OFFSET_RESET=earliest

# Kafka consumer enable auto commit (set to false for manual offset management)
KAFKA_ENABLE_AUTO_COMMIT=false


# -----------------------------------------------------------------------------
# LIVE DATA APIs (Sprint 1)
# -----------------------------------------------------------------------------

# Finnhub API Key for real-time market ticks (Free tier: 60 req/min)
FINNHUB_API_KEY=your_finnhub_api_key_here

# MarketAux API Key for news sentiment (Free tier: 100 req/day)
MARKETAUX_API_KEY=your_marketaux_api_key_here

# -----------------------------------------------------------------------------
# DATA REPLAY PRODUCER — Historical data replay settings
# -----------------------------------------------------------------------------

# Absolute path to the tick data CSV file inside the producer container
REPLAY_TICK_DATA_PATH=/app/data/raw/tick_data.csv

# Absolute path to the sentiment scores CSV file inside the producer container
REPLAY_SENTIMENT_DATA_PATH=/app/data/raw/sentiment_scores.csv

# Speed multiplier for the historical replay.
# 1.0  = real-time (actual time elapsed between events)
# 10.0 = 10× faster than real-time
# 0    = maximum speed (no sleep between messages; use for testing only)
# Recommended for development: 100.0
REPLAY_SPEED_MULTIPLIER=100.0

# Number of CSV rows to buffer in memory before streaming to Kafka
# Larger batches improve throughput; smaller batches reduce memory footprint
REPLAY_BATCH_SIZE=500

# Ticker symbols to include in the replay (comma-separated).
# Leave empty to replay all tickers in the dataset.
# Example: AAPL,TSLA,MSFT
REPLAY_TICKER_FILTER=

# Whether to loop the replay indefinitely (true) or stop after the CSV is exhausted (false)
REPLAY_LOOP=false

# Delay in seconds between the end of one loop iteration and the start of the next
REPLAY_LOOP_DELAY_SECONDS=5


# -----------------------------------------------------------------------------
# FASTAPI SERVICE — API server configuration
# -----------------------------------------------------------------------------

# Host the API server binds to (0.0.0.0 to accept connections from all interfaces)
API_HOST=0.0.0.0

# Port the API server listens on
API_PORT=8000

# Number of Uvicorn worker processes (set to 1 for debugging; match CPU count for production)
API_WORKERS=1

# API log level: 'debug' | 'info' | 'warning' | 'error' | 'critical'
API_LOG_LEVEL=info

# CORS allowed origins (comma-separated). Use '*' for local development only.
API_CORS_ORIGINS=*

# Rate limiting: maximum requests per minute per client IP
API_MAX_REQUESTS_PER_MINUTE=60

# Rate limiting: burst allowance above the per-minute limit
API_RATE_LIMIT_BURST=10

# API version string (echoed in responses and health checks)
API_VERSION=1.0.0


# -----------------------------------------------------------------------------
# ML MODEL — Artefact paths and inference settings
# -----------------------------------------------------------------------------

# Path to the serialised XGBoost model file (inside the API container)
MODEL_ARTEFACT_PATH=/app/model/artefacts/xgb_model.json

# Path to the serialised scikit-learn scaler (inside the API container)
SCALER_ARTEFACT_PATH=/app/model/artefacts/scaler.pkl

# Model version string written to every PredictionResponse
MODEL_VERSION=xgb_v1.0.0

# Number of top SHAP factors to include in each prediction response
SHAP_TOP_FACTORS=3

# Whether to write each prediction to marts.predictions in PostgreSQL
# Set to false for load testing to avoid DB bottleneck
PREDICTION_WRITE_TO_DB=true


# -----------------------------------------------------------------------------
# GRAFANA — Dashboard configuration
# -----------------------------------------------------------------------------

# Grafana admin username (for initial provisioning only)
GRAFANA_ADMIN_USER=admin

# Grafana admin password  ← REQUIRED (change before any network exposure)
GRAFANA_ADMIN_PASSWORD=changeme_grafana_password

# Grafana anonymous access (true = no login required; acceptable for local dev)
GRAFANA_ANONYMOUS_ENABLED=true

# Grafana server root URL (used for link generation in alerts)
GRAFANA_ROOT_URL=http://localhost:3000

# Grafana PostgreSQL datasource name (must match provisioning YAML)
GRAFANA_DATASOURCE_NAME=MarketPulse-Postgres


# -----------------------------------------------------------------------------
# DBT — Transformation pipeline settings
# -----------------------------------------------------------------------------

# dbt target environment (dev | prod)
DBT_TARGET=dev

# dbt run interval in seconds (how often the dbt runner container re-executes models)
DBT_RUN_INTERVAL_SECONDS=300

# dbt log level: 'debug' | 'info' | 'warn' | 'error'
DBT_LOG_LEVEL=info

# dbt threads (number of parallel model executions)
DBT_THREADS=4


# -----------------------------------------------------------------------------
# LOGGING — Shared logging configuration
# -----------------------------------------------------------------------------

# Log level for all Python services (overridden per-service by API_LOG_LEVEL)
LOG_LEVEL=INFO

# Log format: 'json' for structured logging | 'text' for human-readable
LOG_FORMAT=json

# Include service name in every log entry (used for log aggregation)
LOG_SERVICE_NAME=marketpulseai
